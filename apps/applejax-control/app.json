{
  "expo": {
    "name": "appleJax Control",
    "slug": "applejax-control",
    "scheme": "applejax",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshpointer.applejax.control",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "appleJax Control captures microphone audio to drive the visualizer on your Apple TV.",
        "NSLocalNetworkUsageDescription": "appleJax Control streams audio data to the appleJax tvOS app on your local network.",
        "NSAppleMusicUsageDescription": "appleJax Control reads your local music library so you can stream owned tracks to the visualizer.",
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.joshpointer.applejax.control",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "READ_MEDIA_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "4df698aa-08cd-43a3-ad0d-27984aab5c99"
      }
    }
  }
}
